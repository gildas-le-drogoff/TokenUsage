<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for the compact quota tile. RemoteViews only allows
     a fixed set of view classes: TextViews double as the brand dots. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B817161C"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#FFD4A574" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Claude"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="42% left"
        android:textColor="#FF81C784"
        android:textSize="22sp"
        android:textStyle="bold" />
    <ProgressBar
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="42"
        android:progressBackgroundTint="#33FFFFFF"
        android:progressTint="#FF81C784"
        style="?android:attr/progressBarStyleHorizontal" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="5-Hour"
        android:textColor="#99FFFFFF"
        android:textSize="10sp" />
</LinearLayout>
